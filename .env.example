APP_NAME=Decorron
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Sofia
APP_URL=http://localhost:8000

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG

# Регистрацията на нови потребители. В production я изключете (false),
# след като си създадете профил — приложението е за един екип/фирма.
APP_REGISTRATION_ENABLED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=decorron
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@decorron.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Използват се само от `php artisan db:seed`. Не ги оставяйте в production .env.
# Ако ADMIN_PASSWORD е празна, seeder-ът генерира случайна и я показва веднъж.
ADMIN_NAME="Администратор"
ADMIN_EMAIL=admin@decorron.local
ADMIN_PASSWORD=
